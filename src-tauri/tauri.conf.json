{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiersCRM",
  "version": "0.7.1",
  "identifier": "fr.insrt.pierscrm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PiersCRM",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Booking & artist management",
    "longDescription": "PiersCRM — all-in-one desktop app for booking and artist management: contacts pipeline, artist EPKs, emails, budget, visas.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/insrtstudio/pierscrm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCRjJBNjJBNkE5MjlENDMKUldSRG5aSnFLcWJ5RzRHakoyYUVoTi9GYWJXdnNRWDRZR0liMEdsUkovYkk4U21HR21VTDZNNXcK"
    }
  }
}
